#include <windows.h>
#include "resource.h"

// resources.rc is UTF-8. Keep rc.exe from interpreting Chinese dialog text
// with the runner machine's legacy ANSI code page.
#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDR_CAT RCDATA "Sources/DesktopPet/Resources/cat.png"
IDR_CAT_BLINK RCDATA "Sources/DesktopPet/Resources/cat-blink.png"
IDR_CAT_WALK_1 RCDATA "Sources/DesktopPet/Resources/cat-walk-1.png"
IDR_CAT_WALK_2 RCDATA "Sources/DesktopPet/Resources/cat-walk-2.png"
IDR_CAT_WALK_3 RCDATA "Sources/DesktopPet/Resources/cat-walk-3.png"
IDR_CAT_WALK_4 RCDATA "Sources/DesktopPet/Resources/cat-walk-4.png"
IDR_CAT_WAITING RCDATA "Sources/DesktopPet/Resources/cat-waiting.png"
IDR_CAT_WAITING_BLINK RCDATA "Sources/DesktopPet/Resources/cat-waiting-blink.png"
IDR_CAT_WAITING_EAR RCDATA "Sources/DesktopPet/Resources/cat-waiting-ear.png"
IDR_CAT_WAITING_TAIL RCDATA "Sources/DesktopPet/Resources/cat-waiting-tail.png"
IDR_CAT_LIFT RCDATA "Sources/DesktopPet/Resources/cat-lift.png"
IDR_CAT_LIFT_BLINK RCDATA "Sources/DesktopPet/Resources/cat-lift-blink.png"
IDI_APP_ICON ICON "windows/cat-icon.ico"
1 RT_MANIFEST "windows/app.manifest"

IDD_DEEPSEEK_SETTINGS DIALOGEX 0, 0, 284, 166
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "职业咨询模型设置（DeepSeek）"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "API Key（安全保存到 Windows 凭据管理器）", -1, 10, 10, 264, 12
    EDITTEXT        IDC_API_KEY, 10, 25, 264, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "模型", -1, 10, 51, 50, 12
    COMBOBOX        IDC_MODEL, 10, 65, 264, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "生涯资料单份上限（1–100 MB）", -1, 10, 92, 180, 12
    EDITTEXT        IDC_FILE_LIMIT_MB, 196, 89, 78, 17, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "每批最多 5 个文件，总量和解析结果分别不超过 100 MB。", -1, 10, 114, 264, 12
    PUSHBUTTON      "清除密钥", IDC_CLEAR_KEY, 10, 141, 58, 15
    DEFPUSHBUTTON   "保存", IDOK, 176, 141, 46, 15
    PUSHBUTTON      "取消", IDCANCEL, 228, 141, 46, 15
END

IDD_FILE_ANALYSIS_CHAT DIALOGEX 0, 0, 304, 76
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "让哈妮丝分析生涯资料"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL         "", IDC_CHAT_ATTACHMENTS, "STATIC", SS_LEFT | SS_CENTERIMAGE | SS_ENDELLIPSIS | WS_BORDER, 10, 9, 284, 18
    EDITTEXT        IDC_CHAT_INPUT, 10, 34, 228, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "发送", IDOK, 244, 34, 50, 18
    LTEXT           "Enter 发送  ·  Esc 关闭", -1, 10, 59, 150, 10
END

IDD_DEEPSEEK_CHAT DIALOGEX 0, 0, 284, 50
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "和哈妮丝开始本轮生涯规划"
FONT 9, "Microsoft YaHei UI"
BEGIN
    EDITTEXT        IDC_CHAT_INPUT, 10, 10, 218, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "发送", IDOK, 234, 10, 40, 18
    LTEXT           "Enter 发送  ·  Esc 关闭", -1, 10, 35, 150, 10
END

IDD_AGENT_PLUGIN_SETTINGS DIALOGEX 0, 0, 420, 295
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "哈妮丝 · 生涯规划助手设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "职业咨询猫人设与安全规则由应用内置；这里只配置辅助能力。", -1, 14, 10, 392, 13
    LTEXT           "设置会在保存后重启生涯规划助手，并校验实际辅助能力。", IDC_PLUGIN_RUNTIME_STATUS, 14, 32, 392, 13
    AUTOCHECKBOX    "辅助技能库", IDC_PLUGIN_SKILLS, 16, 55, 170, 14, WS_TABSTOP
    LTEXT           "加载生涯资料目录 .desktop-pet/skills 中的技能。", -1, 34, 71, 265, 12
    RTEXT           "", IDC_PLUGIN_SKILLS_STATUS, 302, 56, 104, 12
    AUTOCHECKBOX    "行动清单", IDC_PLUGIN_TODO, 16, 95, 170, 14, WS_TABSTOP
    LTEXT           "启用行动清单，跟踪多步骤内容。", -1, 34, 111, 265, 12
    RTEXT           "", IDC_PLUGIN_TODO_STATUS, 302, 96, 104, 12
    AUTOCHECKBOX    "成长目标", IDC_PLUGIN_GOALS, 16, 135, 170, 14, WS_TABSTOP
    LTEXT           "启用目标工具，持续跟进成长目标。", -1, 34, 151, 265, 12
    RTEXT           "", IDC_PLUGIN_GOALS_STATUS, 302, 136, 104, 12
    AUTOCHECKBOX    "资料搜索", IDC_PLUGIN_WEB_SEARCH, 16, 175, 190, 14, WS_TABSTOP
    LTEXT           "复用现有 API Key；会产生额外模型调用和 Token 消耗。", -1, 34, 191, 265, 12
    RTEXT           "", IDC_PLUGIN_WEB_SEARCH_STATUS, 302, 176, 104, 12
    CONTROL         "", -1, "STATIC", SS_ETCHEDHORZ, 14, 215, 392, 1
    LTEXT           "", IDC_PLUGIN_SKILL_SUMMARY, 16, 227, 390, 13, SS_LEFT | SS_ENDELLIPSIS
    PUSHBUTTON      "打开技能目录", IDC_PLUGIN_OPEN_SKILLS, 16, 266, 78, 19
    PUSHBUTTON      "刷新状态", IDC_PLUGIN_REFRESH, 101, 266, 64, 19
    PUSHBUTTON      "取消", IDCANCEL, 276, 266, 56, 19
    DEFPUSHBUTTON   "保存并重启", IDOK, 338, 266, 68, 19
END

IDD_WAITING_SETTINGS DIALOGEX 0, 0, 264, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "陪伴等待设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "连续无交互多少分钟后，让哈妮丝蹲坐陪伴等待？", -1, 10, 10, 244, 12
    EDITTEXT        IDC_WAITING_MINUTES, 10, 27, 244, 17, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "填写 0 可关闭；允许范围 0–1440 分钟。", -1, 10, 49, 244, 12
    DEFPUSHBUTTON   "保存", IDOK, 158, 66, 46, 15
    PUSHBUTTON      "取消", IDCANCEL, 210, 66, 44, 15
END

1 VERSIONINFO
 FILEVERSION 0,7,2,0
 PRODUCTVERSION 0,7,2,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "DesktopPet"
            VALUE "FileDescription", "哈妮丝 - 学生职业咨询猫"
            VALUE "FileVersion", "0.7.2"
            VALUE "InternalName", "DesktopPet"
            VALUE "OriginalFilename", "DesktopPet-Windows-x64.exe"
            VALUE "ProductName", "哈妮丝"
            VALUE "ProductVersion", "0.7.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
