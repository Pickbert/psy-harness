#include <windows.h>
#include "resource.h"

// resources.rc is UTF-8. Keep rc.exe from interpreting Chinese dialog text
// with the runner machine's legacy ANSI code page.
#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDR_SHIBA RCDATA "Sources/DesktopPet/Resources/shiba.png"
IDR_SHIBA_BLINK RCDATA "Sources/DesktopPet/Resources/shiba-blink-v2.png"
IDR_SHIBA_WALK_1 RCDATA "Sources/DesktopPet/Resources/shiba-walk-1-v2.png"
IDR_SHIBA_WALK_2 RCDATA "Sources/DesktopPet/Resources/shiba-walk-2-v2.png"
IDR_SHIBA_WALK_3 RCDATA "Sources/DesktopPet/Resources/shiba-walk-3-v2.png"
IDR_SHIBA_WALK_4 RCDATA "Sources/DesktopPet/Resources/shiba-walk-4-v2.png"
IDR_SHIBA_WAITING RCDATA "Sources/DesktopPet/Resources/shiba-waiting.png"
IDR_SHIBA_WAITING_BLINK RCDATA "Sources/DesktopPet/Resources/shiba-waiting-blink.png"
IDR_SHIBA_WAITING_EAR RCDATA "Sources/DesktopPet/Resources/shiba-waiting-ear.png"
IDR_SHIBA_WAITING_TAIL RCDATA "Sources/DesktopPet/Resources/shiba-waiting-tail.png"
IDR_SHIBA_LIFT_1 RCDATA "Sources/DesktopPet/Resources/shiba-lift-1.png"
IDR_SHIBA_LIFT_BLINK RCDATA "Sources/DesktopPet/Resources/shiba-lift-blink.png"
IDI_APP_ICON ICON "windows/shiba-icon.ico"
1 RT_MANIFEST "windows/app.manifest"

IDD_DEEPSEEK_SETTINGS DIALOGEX 0, 0, 284, 166
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DeepSeek 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "API Key（安全保存到 Windows 凭据管理器）", -1, 10, 10, 264, 12
    EDITTEXT        IDC_API_KEY, 10, 25, 264, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "模型", -1, 10, 51, 50, 12
    COMBOBOX        IDC_MODEL, 10, 65, 264, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "文件分析单文件上限（1–100 MB）", -1, 10, 92, 180, 12
    EDITTEXT        IDC_FILE_LIMIT_MB, 196, 89, 78, 17, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "每批最多 5 个文件，总量和解析结果分别不超过 100 MB。", -1, 10, 114, 264, 12
    PUSHBUTTON      "清除密钥", IDC_CLEAR_KEY, 10, 141, 58, 15
    DEFPUSHBUTTON   "保存", IDOK, 176, 141, 46, 15
    PUSHBUTTON      "取消", IDCANCEL, 228, 141, 46, 15
END

IDD_FILE_ANALYSIS_CHAT DIALOGEX 0, 0, 304, 76
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "让哈妮丝分析文件"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL         "", IDC_CHAT_ATTACHMENTS, "STATIC", SS_LEFT | SS_CENTERIMAGE | SS_ENDELLIPSIS | WS_BORDER, 10, 9, 284, 18
    EDITTEXT        IDC_CHAT_INPUT, 10, 34, 228, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "发送", IDOK, 244, 34, 50, 18
    LTEXT           "Enter 发送  ·  Esc 关闭", -1, 10, 59, 150, 10
END

IDD_DEEPSEEK_CHAT DIALOGEX 0, 0, 284, 50
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "问问哈妮丝"
FONT 9, "Microsoft YaHei UI"
BEGIN
    EDITTEXT        IDC_CHAT_INPUT, 10, 10, 218, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "发送", IDOK, 234, 10, 40, 18
    LTEXT           "Enter 发送  ·  Esc 关闭", -1, 10, 35, 150, 10
END

IDD_AGENT_PLUGIN_SETTINGS DIALOGEX 0, 0, 420, 282
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "哈妮丝 · 插件与技能"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "配置会在保存后重启 Agent，并通过 Harness 实际工具注册表校验。", IDC_PLUGIN_RUNTIME_STATUS, 14, 11, 392, 13
    AUTOCHECKBOX    "本地技能库", IDC_PLUGIN_SKILLS, 16, 35, 170, 14, WS_TABSTOP
    LTEXT           "加载工作目录 .desktop-pet/skills 中的技能。", -1, 34, 51, 265, 12
    RTEXT           "", IDC_PLUGIN_SKILLS_STATUS, 302, 36, 104, 12
    AUTOCHECKBOX    "任务清单", IDC_PLUGIN_TODO, 16, 79, 170, 14, WS_TABSTOP
    LTEXT           "启用 todo_write，跟踪多步骤任务。", -1, 34, 95, 265, 12
    RTEXT           "", IDC_PLUGIN_TODO_STATUS, 302, 80, 104, 12
    AUTOCHECKBOX    "长期目标", IDC_PLUGIN_GOALS, 16, 123, 170, 14, WS_TABSTOP
    LTEXT           "启用目标创建、查询和更新工具。", -1, 34, 139, 265, 12
    RTEXT           "", IDC_PLUGIN_GOALS_STATUS, 302, 124, 104, 12
    AUTOCHECKBOX    "DeepSeek 网页搜索", IDC_PLUGIN_WEB_SEARCH, 16, 167, 190, 14, WS_TABSTOP
    LTEXT           "复用现有 API Key；会产生额外模型调用和 Token 消耗。", -1, 34, 183, 265, 12
    RTEXT           "", IDC_PLUGIN_WEB_SEARCH_STATUS, 302, 168, 104, 12
    CONTROL         "", -1, "STATIC", SS_ETCHEDHORZ, 14, 207, 392, 1
    LTEXT           "", IDC_PLUGIN_SKILL_SUMMARY, 16, 218, 390, 13, SS_LEFT | SS_ENDELLIPSIS
    PUSHBUTTON      "打开技能目录", IDC_PLUGIN_OPEN_SKILLS, 16, 248, 78, 19
    PUSHBUTTON      "刷新状态", IDC_PLUGIN_REFRESH, 101, 248, 64, 19
    PUSHBUTTON      "取消", IDCANCEL, 276, 248, 56, 19
    DEFPUSHBUTTON   "保存并重启", IDOK, 338, 248, 68, 19
END

IDD_WAITING_SETTINGS DIALOGEX 0, 0, 264, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "等待召唤设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "连续无交互多少分钟后，让哈妮丝蹲坐等待？", -1, 10, 10, 244, 12
    EDITTEXT        IDC_WAITING_MINUTES, 10, 27, 244, 17, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "填写 0 可关闭；允许范围 0–1440 分钟。", -1, 10, 49, 244, 12
    DEFPUSHBUTTON   "保存", IDOK, 158, 66, 46, 15
    PUSHBUTTON      "取消", IDCANCEL, 210, 66, 44, 15
END

1 VERSIONINFO
 FILEVERSION 0,7,1,0
 PRODUCTVERSION 0,7,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "DesktopPet"
            VALUE "FileDescription", "哈妮丝 - Windows 桌面宠物"
            VALUE "FileVersion", "0.7.1"
            VALUE "InternalName", "DesktopPet"
            VALUE "OriginalFilename", "DesktopPet-Windows-x64.exe"
            VALUE "ProductName", "哈妮丝"
            VALUE "ProductVersion", "0.7.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
